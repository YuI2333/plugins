#!name = 腾讯视频净化
#!desc = 去除开屏广告、视频播放前广告、底部的多余 tab 栏、我的页面美化、我的界面顶部广告
#!author = 转换自@ZenMoFiShi
#!date = 2026-10-27

[Rule]
DOMAIN, iacc.stgw.qq.com, REJECT
DOMAIN, tacc.video.qq.com, REJECT

[Script]
http-request ^https?:\/\/i\.video\.qq\.com\/(?:\?.*)?$ script-path=https://raw.githubusercontent.com/YuI2333/plugins/refs/heads/main/TXvideo/TXvideoad.js, requires-body=true, binary-body-mode=true, timeout=10, tag=腾讯视频-请求体处理
http-response ^https?:\/\/(i\.video|iacc)\.qq\.com\/(?:\?.*)?$ script-path=https://raw.githubusercontent.com/YuI2333/plugins/refs/heads/main/TXvideo/TXvideoad.js, requires-body=true, binary-body-mode=true, timeout=10, tag=腾讯视频-接口响应净化
http-response ^https?:\/\/config\.ab\.qq\.com\/tab\/GetTabRemoteConfig(?:\?.*)?$ script-path=https://raw.githubusercontent.com/YuI2333/plugins/refs/heads/main/TXvideo/TXvideoad.js, requires-body=true, binary-body-mode=true, timeout=10, tag=腾讯视频-底部Tab净化
http-response ^https:\/\/rdelivery\.qq\.com\/v1\/sdkconfig\/get(?:\?.*)?$ script-path=https://raw.githubusercontent.com/YuI2333/plugins/refs/heads/main/TXvideo/TXvideoad.js, requires-body=true, timeout=10, tag=腾讯视频-配置下发净化

[MITM]
hostname = i.video.qq.com, iacc.qq.com, config.ab.qq.com, rdelivery.qq.com
