#!name=App Store 下载提速
#!desc=通过指定 CDN 节点加速 App Store 应用下载，支持在插件设置中自由切换节点。

[Argument]
AppStore_CDN = select, "iosapps.itunes.apple.com.download.ks-cdn.com"="金山云 CDN", "hls.itunes.apple.com.mwcname.com"="网宿 CDN", "iosapps.itunes.apple.com.m.alikunlun.net"="阿里云 CDN", title="选择 CDN 节点", desc="选择 App Store 下载加速节点"

[Host]
iosapps.itunes.apple.com = {AppStore_CDN}
