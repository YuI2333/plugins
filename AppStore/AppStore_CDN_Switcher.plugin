#!name=App Store 下载提速
#!desc=通过指定 CDN 节点加速 App Store 应用下载，支持在插件设置中自由切换节点。
#!author=YuI2333
#!system=ios

[Argument]
AppStore_CDN = select, "ks-cdn (金山云)=iosapps.itunes.apple.com.download.ks-cdn.com", "mwcname (网宿)=hls.itunes.apple.com.mwcname.com", "alikunlun (阿里云)=iosapps.itunes.apple.com.m.alikunlun.net", title="选择 CDN 节点", desc="选择 CDN 节点以加速 App Store 下载"

[Host]
iosapps.itunes.apple.com = {AppStore_CDN}
