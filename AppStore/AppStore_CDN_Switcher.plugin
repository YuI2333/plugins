#!name=App Store 下载提速
#!desc=通过指定 CDN 节点加速 App Store 应用下载，支持在插件设置中自由切换节点。
#!author=YuI2333
#!system=ios

[Argument]
AppStore_CDN = select, {"金山":"iosapps.itunes.apple.com.download.ks-cdn.com","网宿":"hls.itunes.apple.com.mwcname.com","阿里":"iosapps.itunes.apple.com.m.alikunlun.net"}, title="选择 CDN 节点", desc="选择需要使用的加速节点，关闭插件恢复系统默认。"

[Host]
iosapps.itunes.apple.com = {AppStore_CDN}
