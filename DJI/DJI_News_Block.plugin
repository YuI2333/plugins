#!name=屏蔽大疆 DJI 推送与广告
#!desc=清除 DJI App 中的 dji_news 活动推送与红点，拦截大疆商城开屏广告，保留客服及系统通知
#!author=YuI2333
#!system=ios

[Rule]
# 拦截大疆商城开屏广告
URL-REGEX,^https:\/\/se-api\.djiits\.com\/api\/components\/launch_ad\.json.*,REJECT-DICT
# 拦截 dji_news 列表 API 请求，防止加载历史广告消息
URL-REGEX,^https:\/\/plus\.dji\.com\/api\/v5\/notifications\?.*notification_type=dji_news,REJECT-DICT

[Script]
# 清除红点与最新消息的外部预览
http-response ^https:\/\/plus\.dji\.com\/api\/v5\/notifications\/unread_infos script-path=https://raw.githubusercontent.com/YuI2333/plugins/refs/heads/main/DJI/dji_news_block.js, requires-body=true, timeout=60, tag=屏蔽DJI News红点

[MitM]
hostname = plus.dji.com, se-api.djiits.com
