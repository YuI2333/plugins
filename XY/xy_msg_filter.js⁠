let body = $response.body;
try {
    let obj = JSON.parse(body);
    if (obj.data && obj.data.sessions) {
        obj.data.sessions = obj.data.sessions.filter(item => {
            let summary = item?.message?.summary?.summary || "";
            // 过滤包含“100闲鱼币待领”的消息
            if (summary.includes("100闲鱼币待领")) {
                return false;
            }
            // 可选：过滤整个系统消息会话（取消下方注释即可生效）
            // let nick = item?.session?.userInfo?.nick || "";
            // if (nick === "系统消息") return false;
            
            return true;
        });
        body = JSON.stringify(obj);
    }
} catch (e) {
    console.log("闲鱼消息脚本解析异常: " + e.message);
}
$done({body});
