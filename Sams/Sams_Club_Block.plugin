#!name=山姆会员商店净化
#!desc=拦截山姆App调研弹窗、通知按钮红点数字、搜索框推荐词、购物车猜你喜欢、我的页面常买列表以及门店页面商品列表

[Rewrite]
# 山姆调研
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/configuration\/research\/getQuestion$ reject-dict
# 山姆通知按钮数字
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/message\/portal\/systemMessage\/getTotalUnreadCount$ reject-dict
# 山姆搜索框推荐词
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/configuration\/searchTextConf\/queryList$ reject-dict
# 山姆购物车猜你喜欢
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/goods-sr-portal\/cartRecommendFlow\/recommend$ reject-dict
# 山姆我的页面常买列表
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/edge\/trade\/order\/getOftenBuyGoods$ reject-dict
# 山姆门店页面商品列表
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/merchant\/visitStoreApi\/queryRecommendGoodsList$ reject-dict

[MitM]
hostname = api-sams.walmartmobile.cn
