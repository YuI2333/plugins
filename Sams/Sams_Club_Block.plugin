#!name=山姆会员商店净化
#!desc=拦截山姆App调研弹窗、通知按钮红点数字、搜索框推荐词、购物车猜你喜欢、我的页面常买列表以及门店页面商品列表

[Rewrite]
# 购物车数量角标
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/trade\/cart\/getTotalGoodsNum$ reject-200
# 商品详情底部一起买
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/goods-portal\/spu\/queryBySpuId$ reject-dict
# 我的页面自动续费横幅
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/channel\/portal\/AdgroupData\/queryAdgroup$ reject-200
# 山姆调研
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/configuration\/research\/getQuestion$ reject-dict
# 山姆通知按钮数字
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/message\/portal\/systemMessage\/getTotalUnreadCount$ reject-dict
# 山姆搜索框推荐词
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/configuration\/searchTextConf\/queryList$ reject-dict
# 山姆购物车猜你喜欢
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/goods-sr-portal\/cartRecommendFlow\/recommend$ reject-dict
# 山姆我的页面常买列表
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/edge\/trade\/order\/getOftenBuyGoods$ reject-dict
# 山姆门店页面商品列表
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/merchant\/visitStoreApi\/queryRecommendGoodsList$ reject-dict
# 通知内容一刀切全干掉
^https?:\/\/api-green-sams\.walmartmobile\.cn\/api\/v1\/sams\/message\/portal\/systemMessage\/getHomeMessageList$ reject-dict
# 我的页面门店服务
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/merchant\/storeApi\/getStoreServerListV2$ reject-dict
# 搜索界面热搜精选
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/channel\/searchRankGroup\/getOneGroup reject-dict
# 搜索界面猜你喜欢
^https?://api-sams.walmartmobile.cn/api/v1/sams/configuration/hotwordsStore/queryList reject-dict
# 拦截卓越会员升级弹窗与开屏促销广告
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v\d\/sams\/sams-user\/(window\/getGoUpPlus|screen_promotion\/get) reject
# 拦截个人中心推广入口
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v\d\/sams\/configuration\/personCenterEntrance\/query reject-dict
# 拦截App版本更新提示
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v\d\/sams\/configuration\/appVersionUpdate\/getAppVersionUpdateInfo reject-dict
# 拦截App强制更新机制
^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/configuration\/portal\/beUpdate reject-dict

[MitM]
hostname = api-sams.walmartmobile.cn,api-green-sams.walmartmobile.cn
