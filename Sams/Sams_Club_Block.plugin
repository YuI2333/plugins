#!name=山姆会员商店净化
#!desc=拦截山姆App调研弹窗、通知按钮红点数字以及搜索框推荐词

[Rule]
# 山姆调研
URL-REGEX,^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/configuration\/research\/getQuestion$,REJECT-DICT
# 山姆通知按钮数字
URL-REGEX,^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/message\/portal\/systemMessage\/getTotalUnreadCount$,REJECT-DICT
# 山姆搜索框推荐词
URL-REGEX,^https?:\/\/api-sams\.walmartmobile\.cn\/api\/v1\/sams\/configuration\/searchTextConf\/queryList$,REJECT-DICT

[MitM]
hostname = api-sams.walmartmobile.cn
